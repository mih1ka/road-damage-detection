# *.ipynb

# ── Virtual environments ───────────────────────────────
venv/
env/
.env/
.venv/
ENV/

# ── Environment variables (never push secrets) ─────────
.env
.env.local
*.env

# ── Streamlit ──────────────────────────────────────────
.streamlit/secrets.toml

# ── Dataset files (download via kagglehub instead) ─────
data/
datasets/
*.csv
*.json
!package.json

# ── Generated images from notebook ─────────────────────
*.png
*.jpg
*.jpeg

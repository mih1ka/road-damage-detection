# ── Model weights (too large for GitHub) ──────────────
*.pth
*.pt
*.ckpt
*.h5
*.pkl

# ── Python cache ───────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python

# ── Jupyter / Colab ────────────────────────────────────
.ipynb_checkpoints/
*.ipynb_checkpoints
*/.ipynb_checkpoints/*
